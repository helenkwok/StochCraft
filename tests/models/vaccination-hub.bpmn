<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpsim="http://www.bpsim.org/schemas/2.0" id="definitions" name="Mass vaccination hub" targetNamespace="https://github.com/helenkwok/StochCraft/model" exporter="StochCraft" exporterVersion="0.2.0">
  <bpmn:resource id="entrance_resource" name="Entrance"/>
  <bpmn:resource id="registration_resource" name="Registration"/>
  <bpmn:resource id="assessment_resource" name="Assessment"/>
  <bpmn:resource id="preparation_resource" name="Dose preparation"/>
  <bpmn:resource id="vaccination_resource" name="Vaccination"/>
  <bpmn:resource id="observation_resource" name="Observation seats"/>
  <bpmn:process id="process" name="Mass vaccination hub" isExecutable="false">
    <bpmn:startEvent id="patients" name="Patients arrive">
      <bpmn:outgoing>flow-1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="split" name="Patient and dose">
      <bpmn:incoming>flow-1</bpmn:incoming>
      <bpmn:outgoing>flow-2</bpmn:outgoing>
      <bpmn:outgoing>flow-3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="entrance" name="Entrance">
      <bpmn:incoming>flow-2</bpmn:incoming>
      <bpmn:outgoing>flow-4</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>entrance_resource</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:task id="registration" name="Registration">
      <bpmn:incoming>flow-4</bpmn:incoming>
      <bpmn:outgoing>flow-5</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>registration_resource</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:task id="assessment" name="Assessment">
      <bpmn:incoming>flow-5</bpmn:incoming>
      <bpmn:outgoing>flow-6</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>assessment_resource</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:task id="preparation" name="Dose preparation">
      <bpmn:incoming>flow-3</bpmn:incoming>
      <bpmn:outgoing>flow-7</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>preparation_resource</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:parallelGateway id="join" name="Patient meets dose">
      <bpmn:incoming>flow-6</bpmn:incoming>
      <bpmn:incoming>flow-7</bpmn:incoming>
      <bpmn:outgoing>flow-8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="vaccination" name="Vaccination">
      <bpmn:incoming>flow-8</bpmn:incoming>
      <bpmn:outgoing>flow-9</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>vaccination_resource</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:task id="observation" name="Observation seats">
      <bpmn:incoming>flow-9</bpmn:incoming>
      <bpmn:outgoing>flow-10</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>observation_resource</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:endEvent id="leave" name="Patients leave">
      <bpmn:incoming>flow-10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow-1" sourceRef="patients" targetRef="split"/>
    <bpmn:sequenceFlow id="flow-2" sourceRef="split" targetRef="entrance"/>
    <bpmn:sequenceFlow id="flow-3" sourceRef="split" targetRef="preparation"/>
    <bpmn:sequenceFlow id="flow-4" sourceRef="entrance" targetRef="registration"/>
    <bpmn:sequenceFlow id="flow-5" sourceRef="registration" targetRef="assessment"/>
    <bpmn:sequenceFlow id="flow-6" sourceRef="assessment" targetRef="join"/>
    <bpmn:sequenceFlow id="flow-7" sourceRef="preparation" targetRef="join"/>
    <bpmn:sequenceFlow id="flow-8" sourceRef="join" targetRef="vaccination"/>
    <bpmn:sequenceFlow id="flow-9" sourceRef="vaccination" targetRef="observation"/>
    <bpmn:sequenceFlow id="flow-10" sourceRef="observation" targetRef="leave"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="process">
      <bpmndi:BPMNShape id="patients_di" bpmnElement="patients">
        <dc:Bounds x="82" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="split_di" bpmnElement="split">
        <dc:Bounds x="185" y="75" width="50" height="50"/>
