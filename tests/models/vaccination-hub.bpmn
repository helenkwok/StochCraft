        <dc:Bounds x="765" y="75" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="vaccination_di" bpmnElement="vaccination">
        <dc:Bounds x="860" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="observation_di" bpmnElement="observation">
        <dc:Bounds x="1020" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="leave_di" bpmnElement="leave">
        <dc:Bounds x="1192" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-1_di" bpmnElement="flow-1">
        <di:waypoint x="118" y="100"/>
        <di:waypoint x="185" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-2_di" bpmnElement="flow-2">
        <di:waypoint x="235" y="100"/>
        <di:waypoint x="280" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-3_di" bpmnElement="flow-3">
