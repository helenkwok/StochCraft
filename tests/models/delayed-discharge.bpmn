<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpsim="http://www.bpsim.org/schemas/2.0" id="definitions" name="Delayed discharge" targetNamespace="https://github.com/helenkwok/StochCraft/model" exporter="StochCraft" exporterVersion="0.2.0">
  <bpmn:resource id="d2a_beds" name="D2A inpatient beds"/>
  <bpmn:resource id="d2a_places" name="D2A home places"/>
  <bpmn:process id="process" name="Delayed discharge" isExecutable="false">
    <bpmn:startEvent id="patients" name="Patients fit to leave">
      <bpmn:outgoing>flow-1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="needs" name="Nursing home or care at home?">
      <bpmn:incoming>flow-1</bpmn:incoming>
      <bpmn:outgoing>flow-2</bpmn:outgoing>
      <bpmn:outgoing>flow-3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="d2a_inpatient" name="D2A inpatient">
      <bpmn:incoming>flow-2</bpmn:incoming>
      <bpmn:outgoing>flow-4</bpmn:outgoing>
      <bpmn:outgoing>flow-5</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>d2a_beds</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:task id="hospital_nursing_home" name="Waiting in hospital for a nursing home">
      <bpmn:incoming>flow-5</bpmn:incoming>
      <bpmn:outgoing>flow-6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="d2a_home" name="D2A home">
      <bpmn:incoming>flow-3</bpmn:incoming>
      <bpmn:outgoing>flow-7</bpmn:outgoing>
      <bpmn:outgoing>flow-8</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>d2a_places</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:task id="hospital_care_at_home" name="Waiting in hospital for care at home">
      <bpmn:incoming>flow-8</bpmn:incoming>
      <bpmn:outgoing>flow-9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="nursing_home" name="To a nursing home">
      <bpmn:incoming>flow-4</bpmn:incoming>
      <bpmn:incoming>flow-6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="care_at_home" name="Home with care">
      <bpmn:incoming>flow-7</bpmn:incoming>
      <bpmn:incoming>flow-9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow-1" sourceRef="patients" targetRef="needs"/>
    <bpmn:sequenceFlow id="flow-2" sourceRef="needs" targetRef="d2a_inpatient"/>
    <bpmn:sequenceFlow id="flow-3" sourceRef="needs" targetRef="d2a_home"/>
    <bpmn:sequenceFlow id="flow-4" sourceRef="d2a_inpatient" targetRef="nursing_home"/>
    <bpmn:sequenceFlow id="flow-5" sourceRef="d2a_inpatient" targetRef="hospital_nursing_home"/>
    <bpmn:sequenceFlow id="flow-6" sourceRef="hospital_nursing_home" targetRef="nursing_home"/>
    <bpmn:sequenceFlow id="flow-7" sourceRef="d2a_home" targetRef="care_at_home"/>
    <bpmn:sequenceFlow id="flow-8" sourceRef="d2a_home" targetRef="hospital_care_at_home"/>
    <bpmn:sequenceFlow id="flow-9" sourceRef="hospital_care_at_home" targetRef="care_at_home"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="process">
      <bpmndi:BPMNShape id="patients_di" bpmnElement="patients">
        <dc:Bounds x="82" y="262" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="needs_di" bpmnElement="needs">
