<?xml version="1.0" encoding="UTF-8"?>
<!-- Locating a sensor from three noisy distances, a Monte Carlo model written by hand for
     StochCraft's examples (MIT OR Apache-2.0), after Simeonov and Marinov, "Determine the
     Location of Nodes in Wireless Sensor Network by Using Genetic Algorithm", Environment.
     Technology. Resources., Proceedings of the 15th International Scientific and Practical
     Conference, Rezekne, 2024, vol. II, pp. 247-252: anchors at (-1000, -1000), (-400, 800) and
     (1000, -1000) m, a node at (1400, 300) m, and each measured distance the true one plus a
     normal error of standard deviation sigma_d (5 m here; 1 m and 10 m are scenarios). The paper
     finds the position with a genetic algorithm; here each trial works it out in closed form
     (subtracting the first circle's equation from the other two leaves two linear equations,
     solved by Cramer's rule) and then takes one Gauss-Newton step of least squares from there,
     which is the least-squares position to well within the sampling error (a second step
     changes the root mean square error by under 0.01%). The closed form alone is 2.14 sigma_d
     root mean square; least squares is 1.2335 sigma_d, the GDOP of the anchors seen from the
     node.
     Levels 2 to 5 locate the node from anchors that were themselves located, each anchor
     coordinate off by a normal error of variance 0.5 sigma_{k-1}^2, as in the paper. The paper
     takes that sigma from its own runs at the level before; here it is the first-order value
     sigma_k = GDOP sqrt(sigma_d^2 + 0.5 sigma_{k-1}^2) (the outputs predicted1 to predicted5).
     Every level uses the same standard normal draws (e1 to e3 for the distances, f1x to f3y for
     the anchors), scaled, so the levels are compared on common random numbers.
     The answers are position_error_level_1 to 5 and closed_form_error_level_1, each a squared
     position error (m^2) reported by its root mean square (summary="rms", in m); every other
     output is a working step (role="working"), which the results fold away. Each level's root
     mean square is checked against predicted_k, and the closed form's against
     its own first-order value, in crates/engine/tests/examples.rs. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpsim="http://www.bpsim.org/schemas/2.0"
    xmlns:stochcraft="https://helenkwok.github.io/StochCraft/bpsim/1"
    id="sensor-location" name="Locating a sensor" targetNamespace="https://github.com/helenkwok/StochCraft/model">
  <bpmn:relationship type="BPSimData">
    <bpmn:extensionElements>
      <bpsim:BPSimData>
        <bpsim:Scenario id="five-metres" name="Distance error 5 m">
          <bpsim:ScenarioParameters replication="10000" seed="1" baseTimeUnit="min">
            <bpsim:Duration><bpsim:FloatingParameter value="480"/></bpsim:Duration>
            <bpsim:PropertyParameters>
              <bpsim:Property name="sigma_d" type="double"><bpsim:FloatingParameter value="5"/></bpsim:Property>
              <bpsim:Property name="x1" type="double"><bpsim:FloatingParameter value="-1000"/></bpsim:Property>
              <bpsim:Property name="y1" type="double"><bpsim:FloatingParameter value="-1000"/></bpsim:Property>
              <bpsim:Property name="x2" type="double"><bpsim:FloatingParameter value="-400"/></bpsim:Property>
              <bpsim:Property name="y2" type="double"><bpsim:FloatingParameter value="800"/></bpsim:Property>
              <bpsim:Property name="x3" type="double"><bpsim:FloatingParameter value="1000"/></bpsim:Property>
              <bpsim:Property name="y3" type="double"><bpsim:FloatingParameter value="-1000"/></bpsim:Property>
              <bpsim:Property name="node_x" type="double"><bpsim:FloatingParameter value="1400"/></bpsim:Property>
              <bpsim:Property name="node_y" type="double"><bpsim:FloatingParameter value="300"/></bpsim:Property>
              <bpsim:Property name="e1" type="double"><bpsim:NormalDistribution mean="0" standardDeviation="1"/></bpsim:Property>
              <bpsim:Property name="e2" type="double"><bpsim:NormalDistribution mean="0" standardDeviation="1"/></bpsim:Property>
              <bpsim:Property name="e3" type="double"><bpsim:NormalDistribution mean="0" standardDeviation="1"/></bpsim:Property>
              <bpsim:Property name="f1x" type="double"><bpsim:NormalDistribution mean="0" standardDeviation="1"/></bpsim:Property>
              <bpsim:Property name="f1y" type="double"><bpsim:NormalDistribution mean="0" standardDeviation="1"/></bpsim:Property>
              <bpsim:Property name="f2x" type="double"><bpsim:NormalDistribution mean="0" standardDeviation="1"/></bpsim:Property>
              <bpsim:Property name="f2y" type="double"><bpsim:NormalDistribution mean="0" standardDeviation="1"/></bpsim:Property>
              <bpsim:Property name="f3x" type="double"><bpsim:NormalDistribution mean="0" standardDeviation="1"/></bpsim:Property>
              <bpsim:Property name="f3y" type="double"><bpsim:NormalDistribution mean="0" standardDeviation="1"/></bpsim:Property>
            </bpsim:PropertyParameters>
          </bpsim:ScenarioParameters>
          <bpsim:VendorExtension name="stochcraft:monteCarlo" xmlns:stochcraft="https://helenkwok.github.io/StochCraft/bpsim/1">
            <stochcraft:monteCarlo sampling="random">
              <stochcraft:input name="sigma_d" unit="m"/>
              <stochcraft:input name="x1" unit="m"/>
              <stochcraft:input name="y1" unit="m"/>
              <stochcraft:input name="x2" unit="m"/>
              <stochcraft:input name="y2" unit="m"/>
              <stochcraft:input name="x3" unit="m"/>
              <stochcraft:input name="y3" unit="m"/>
              <stochcraft:input name="node_x" unit="m"/>
              <stochcraft:input name="node_y" unit="m"/>
              <stochcraft:output name="true1" expression="sqrt(pow($node_x - $x1, 2) + pow($node_y - $y1, 2))" unit="m" role="working"/>
              <stochcraft:output name="true2" expression="sqrt(pow($node_x - $x2, 2) + pow($node_y - $y2, 2))" unit="m" role="working"/>
              <stochcraft:output name="true3" expression="sqrt(pow($node_x - $x3, 2) + pow($node_y - $y3, 2))" unit="m" role="working"/>
              <stochcraft:output name="range1" expression="$true1 + $sigma_d * $e1" unit="m" role="working"/>
              <stochcraft:output name="range2" expression="$true2 + $sigma_d * $e2" unit="m" role="working"/>
              <stochcraft:output name="range3" expression="$true3 + $sigma_d * $e3" unit="m" role="working"/>
              <stochcraft:output name="gdop" expression="sqrt((pow(($node_x - $x1) div $true1, 2) + pow(($node_x - $x2) div $true2, 2) + pow(($node_x - $x3) div $true3, 2) + pow(($node_y - $y1) div $true1, 2) + pow(($node_y - $y2) div $true2, 2) + pow(($node_y - $y3) div $true3, 2)) div ((pow(($node_x - $x1) div $true1, 2) + pow(($node_x - $x2) div $true2, 2) + pow(($node_x - $x3) div $true3, 2)) * (pow(($node_y - $y1) div $true1, 2) + pow(($node_y - $y2) div $true2, 2) + pow(($node_y - $y3) div $true3, 2)) - pow(($node_x - $x1) div $true1 * ($node_y - $y1) div $true1 + ($node_x - $x2) div $true2 * ($node_y - $y2) div $true2 + ($node_x - $x3) div $true3 * ($node_y - $y3) div $true3, 2)))" role="working"/>
              <stochcraft:output name="predicted1" expression="$gdop * $sigma_d" unit="m" role="working"/>
              <stochcraft:output name="predicted2" expression="$gdop * sqrt($sigma_d * $sigma_d + 0.5 * $predicted1 * $predicted1)" unit="m" role="working"/>
              <stochcraft:output name="predicted3" expression="$gdop * sqrt($sigma_d * $sigma_d + 0.5 * $predicted2 * $predicted2)" unit="m" role="working"/>
              <stochcraft:output name="predicted4" expression="$gdop * sqrt($sigma_d * $sigma_d + 0.5 * $predicted3 * $predicted3)" unit="m" role="working"/>
              <stochcraft:output name="predicted5" expression="$gdop * sqrt($sigma_d * $sigma_d + 0.5 * $predicted4 * $predicted4)" unit="m" role="working"/>
              <stochcraft:output name="start_x1" expression="((pow($range1, 2) - pow($range2, 2) + pow($x2, 2) - pow($x1, 2) + pow($y2, 2) - pow($y1, 2)) * 2 * ($y3 - $y1) - 2 * ($y2 - $y1) * (pow($range1, 2) - pow($range3, 2) + pow($x3, 2) - pow($x1, 2) + pow($y3, 2) - pow($y1, 2))) div (2 * ($x2 - $x1) * 2 * ($y3 - $y1) - 2 * ($y2 - $y1) * 2 * ($x3 - $x1))" unit="m" role="working"/>
              <stochcraft:output name="start_y1" expression="(2 * ($x2 - $x1) * (pow($range1, 2) - pow($range3, 2) + pow($x3, 2) - pow($x1, 2) + pow($y3, 2) - pow($y1, 2)) - (pow($range1, 2) - pow($range2, 2) + pow($x2, 2) - pow($x1, 2) + pow($y2, 2) - pow($y1, 2)) * 2 * ($x3 - $x1)) div (2 * ($x2 - $x1) * 2 * ($y3 - $y1) - 2 * ($y2 - $y1) * 2 * ($x3 - $x1))" unit="m" role="working"/>
              <stochcraft:output name="dist1_1" expression="sqrt(pow($start_x1 - $x1, 2) + pow($start_y1 - $y1, 2))" unit="m" role="working"/>
              <stochcraft:output name="dist2_1" expression="sqrt(pow($start_x1 - $x2, 2) + pow($start_y1 - $y2, 2))" unit="m" role="working"/>
              <stochcraft:output name="dist3_1" expression="sqrt(pow($start_x1 - $x3, 2) + pow($start_y1 - $y3, 2))" unit="m" role="working"/>
              <stochcraft:output name="x1_est" expression="$start_x1 + ((($start_x1 - $x1) div $dist1_1 * ($range1 - $dist1_1) + ($start_x1 - $x2) div $dist2_1 * ($range2 - $dist2_1) + ($start_x1 - $x3) div $dist3_1 * ($range3 - $dist3_1)) * (pow(($start_y1 - $y1) div $dist1_1, 2) + pow(($start_y1 - $y2) div $dist2_1, 2) + pow(($start_y1 - $y3) div $dist3_1, 2)) - (($start_x1 - $x1) div $dist1_1 * ($start_y1 - $y1) div $dist1_1 + ($start_x1 - $x2) div $dist2_1 * ($start_y1 - $y2) div $dist2_1 + ($start_x1 - $x3) div $dist3_1 * ($start_y1 - $y3) div $dist3_1) * (($start_y1 - $y1) div $dist1_1 * ($range1 - $dist1_1) + ($start_y1 - $y2) div $dist2_1 * ($range2 - $dist2_1) + ($start_y1 - $y3) div $dist3_1 * ($range3 - $dist3_1))) div ((pow(($start_x1 - $x1) div $dist1_1, 2) + pow(($start_x1 - $x2) div $dist2_1, 2) + pow(($start_x1 - $x3) div $dist3_1, 2)) * (pow(($start_y1 - $y1) div $dist1_1, 2) + pow(($start_y1 - $y2) div $dist2_1, 2) + pow(($start_y1 - $y3) div $dist3_1, 2)) - pow((($start_x1 - $x1) div $dist1_1 * ($start_y1 - $y1) div $dist1_1 + ($start_x1 - $x2) div $dist2_1 * ($start_y1 - $y2) div $dist2_1 + ($start_x1 - $x3) div $dist3_1 * ($start_y1 - $y3) div $dist3_1), 2))" unit="m" role="working"/>
              <stochcraft:output name="y1_est" expression="$start_y1 + ((pow(($start_x1 - $x1) div $dist1_1, 2) + pow(($start_x1 - $x2) div $dist2_1, 2) + pow(($start_x1 - $x3) div $dist3_1, 2)) * (($start_y1 - $y1) div $dist1_1 * ($range1 - $dist1_1) + ($start_y1 - $y2) div $dist2_1 * ($range2 - $dist2_1) + ($start_y1 - $y3) div $dist3_1 * ($range3 - $dist3_1)) - (($start_x1 - $x1) div $dist1_1 * ($start_y1 - $y1) div $dist1_1 + ($start_x1 - $x2) div $dist2_1 * ($start_y1 - $y2) div $dist2_1 + ($start_x1 - $x3) div $dist3_1 * ($start_y1 - $y3) div $dist3_1) * (($start_x1 - $x1) div $dist1_1 * ($range1 - $dist1_1) + ($start_x1 - $x2) div $dist2_1 * ($range2 - $dist2_1) + ($start_x1 - $x3) div $dist3_1 * ($range3 - $dist3_1))) div ((pow(($start_x1 - $x1) div $dist1_1, 2) + pow(($start_x1 - $x2) div $dist2_1, 2) + pow(($start_x1 - $x3) div $dist3_1, 2)) * (pow(($start_y1 - $y1) div $dist1_1, 2) + pow(($start_y1 - $y2) div $dist2_1, 2) + pow(($start_y1 - $y3) div $dist3_1, 2)) - pow((($start_x1 - $x1) div $dist1_1 * ($start_y1 - $y1) div $dist1_1 + ($start_x1 - $x2) div $dist2_1 * ($start_y1 - $y2) div $dist2_1 + ($start_x1 - $x3) div $dist3_1 * ($start_y1 - $y3) div $dist3_1), 2))" unit="m" role="working"/>
              <stochcraft:output name="position_error_level_1" expression="pow($x1_est - $node_x, 2) + pow($y1_est - $node_y, 2)" unit="m²" summary="rms"/>
              <stochcraft:output name="start_x2" expression="((pow($range1, 2) - pow($range2, 2) + pow(($x2 + sqrt(0.5) * $predicted1 * $f2x), 2) - pow(($x1 + sqrt(0.5) * $predicted1 * $f1x), 2) + pow(($y2 + sqrt(0.5) * $predicted1 * $f2y), 2) - pow(($y1 + sqrt(0.5) * $predicted1 * $f1y), 2)) * 2 * (($y3 + sqrt(0.5) * $predicted1 * $f3y) - ($y1 + sqrt(0.5) * $predicted1 * $f1y)) - 2 * (($y2 + sqrt(0.5) * $predicted1 * $f2y) - ($y1 + sqrt(0.5) * $predicted1 * $f1y)) * (pow($range1, 2) - pow($range3, 2) + pow(($x3 + sqrt(0.5) * $predicted1 * $f3x), 2) - pow(($x1 + sqrt(0.5) * $predicted1 * $f1x), 2) + pow(($y3 + sqrt(0.5) * $predicted1 * $f3y), 2) - pow(($y1 + sqrt(0.5) * $predicted1 * $f1y), 2))) div (2 * (($x2 + sqrt(0.5) * $predicted1 * $f2x) - ($x1 + sqrt(0.5) * $predicted1 * $f1x)) * 2 * (($y3 + sqrt(0.5) * $predicted1 * $f3y) - ($y1 + sqrt(0.5) * $predicted1 * $f1y)) - 2 * (($y2 + sqrt(0.5) * $predicted1 * $f2y) - ($y1 + sqrt(0.5) * $predicted1 * $f1y)) * 2 * (($x3 + sqrt(0.5) * $predicted1 * $f3x) - ($x1 + sqrt(0.5) * $predicted1 * $f1x)))" unit="m" role="working"/>
              <stochcraft:output name="start_y2" expression="(2 * (($x2 + sqrt(0.5) * $predicted1 * $f2x) - ($x1 + sqrt(0.5) * $predicted1 * $f1x)) * (pow($range1, 2) - pow($range3, 2) + pow(($x3 + sqrt(0.5) * $predicted1 * $f3x), 2) - pow(($x1 + sqrt(0.5) * $predicted1 * $f1x), 2) + pow(($y3 + sqrt(0.5) * $predicted1 * $f3y), 2) - pow(($y1 + sqrt(0.5) * $predicted1 * $f1y), 2)) - (pow($range1, 2) - pow($range2, 2) + pow(($x2 + sqrt(0.5) * $predicted1 * $f2x), 2) - pow(($x1 + sqrt(0.5) * $predicted1 * $f1x), 2) + pow(($y2 + sqrt(0.5) * $predicted1 * $f2y), 2) - pow(($y1 + sqrt(0.5) * $predicted1 * $f1y), 2)) * 2 * (($x3 + sqrt(0.5) * $predicted1 * $f3x) - ($x1 + sqrt(0.5) * $predicted1 * $f1x))) div (2 * (($x2 + sqrt(0.5) * $predicted1 * $f2x) - ($x1 + sqrt(0.5) * $predicted1 * $f1x)) * 2 * (($y3 + sqrt(0.5) * $predicted1 * $f3y) - ($y1 + sqrt(0.5) * $predicted1 * $f1y)) - 2 * (($y2 + sqrt(0.5) * $predicted1 * $f2y) - ($y1 + sqrt(0.5) * $predicted1 * $f1y)) * 2 * (($x3 + sqrt(0.5) * $predicted1 * $f3x) - ($x1 + sqrt(0.5) * $predicted1 * $f1x)))" unit="m" role="working"/>
              <stochcraft:output name="dist1_2" expression="sqrt(pow($start_x2 - ($x1 + sqrt(0.5) * $predicted1 * $f1x), 2) + pow($start_y2 - ($y1 + sqrt(0.5) * $predicted1 * $f1y), 2))" unit="m" role="working"/>
              <stochcraft:output name="dist2_2" expression="sqrt(pow($start_x2 - ($x2 + sqrt(0.5) * $predicted1 * $f2x), 2) + pow($start_y2 - ($y2 + sqrt(0.5) * $predicted1 * $f2y), 2))" unit="m" role="working"/>
              <stochcraft:output name="dist3_2" expression="sqrt(pow($start_x2 - ($x3 + sqrt(0.5) * $predicted1 * $f3x), 2) + pow($start_y2 - ($y3 + sqrt(0.5) * $predicted1 * $f3y), 2))" unit="m" role="working"/>
              <stochcraft:output name="x2_est" expression="$start_x2 + ((($start_x2 - ($x1 + sqrt(0.5) * $predicted1 * $f1x)) div $dist1_2 * ($range1 - $dist1_2) + ($start_x2 - ($x2 + sqrt(0.5) * $predicted1 * $f2x)) div $dist2_2 * ($range2 - $dist2_2) + ($start_x2 - ($x3 + sqrt(0.5) * $predicted1 * $f3x)) div $dist3_2 * ($range3 - $dist3_2)) * (pow(($start_y2 - ($y1 + sqrt(0.5) * $predicted1 * $f1y)) div $dist1_2, 2) + pow(($start_y2 - ($y2 + sqrt(0.5) * $predicted1 * $f2y)) div $dist2_2, 2) + pow(($start_y2 - ($y3 + sqrt(0.5) * $predicted1 * $f3y)) div $dist3_2, 2)) - (($start_x2 - ($x1 + sqrt(0.5) * $predicted1 * $f1x)) div $dist1_2 * ($start_y2 - ($y1 + sqrt(0.5) * $predicted1 * $f1y)) div $dist1_2 + ($start_x2 - ($x2 + sqrt(0.5) * $predicted1 * $f2x)) div $dist2_2 * ($start_y2 - ($y2 + sqrt(0.5) * $predicted1 * $f2y)) div $dist2_2 + ($start_x2 - ($x3 + sqrt(0.5) * $predicted1 * $f3x)) div $dist3_2 * ($start_y2 - ($y3 + sqrt(0.5) * $predicted1 * $f3y)) div $dist3_2) * (($start_y2 - ($y1 + sqrt(0.5) * $predicted1 * $f1y)) div $dist1_2 * ($range1 - $dist1_2) + ($start_y2 - ($y2 + sqrt(0.5) * $predicted1 * $f2y)) div $dist2_2 * ($range2 - $dist2_2) + ($start_y2 - ($y3 + sqrt(0.5) * $predicted1 * $f3y)) div $dist3_2 * ($range3 - $dist3_2))) div ((pow(($start_x2 - ($x1 + sqrt(0.5) * $predicted1 * $f1x)) div $dist1_2, 2) + pow(($start_x2 - ($x2 + sqrt(0.5) * $predicted1 * $f2x)) div $dist2_2, 2) + pow(($start_x2 - ($x3 + sqrt(0.5) * $predicted1 * $f3x)) div $dist3_2, 2)) * (pow(($start_y2 - ($y1 + sqrt(0.5) * $predicted1 * $f1y)) div $dist1_2, 2) + pow(($start_y2 - ($y2 + sqrt(0.5) * $predicted1 * $f2y)) div $dist2_2, 2) + pow(($start_y2 - ($y3 + sqrt(0.5) * $predicted1 * $f3y)) div $dist3_2, 2)) - pow((($start_x2 - ($x1 + sqrt(0.5) * $predicted1 * $f1x)) div $dist1_2 * ($start_y2 - ($y1 + sqrt(0.5) * $predicted1 * $f1y)) div $dist1_2 + ($start_x2 - ($x2 + sqrt(0.5) * $predicted1 * $f2x)) div $dist2_2 * ($start_y2 - ($y2 + sqrt(0.5) * $predicted1 * $f2y)) div $dist2_2 + ($start_x2 - ($x3 + sqrt(0.5) * $predicted1 * $f3x)) div $dist3_2 * ($start_y2 - ($y3 + sqrt(0.5) * $predicted1 * $f3y)) div $dist3_2), 2))" unit="m" role="working"/>
              <stochcraft:output name="y2_est" expression="$start_y2 + ((pow(($start_x2 - ($x1 + sqrt(0.5) * $predicted1 * $f1x)) div $dist1_2, 2) + pow(($start_x2 - ($x2 + sqrt(0.5) * $predicted1 * $f2x)) div $dist2_2, 2) + pow(($start_x2 - ($x3 + sqrt(0.5) * $predicted1 * $f3x)) div $dist3_2, 2)) * (($start_y2 - ($y1 + sqrt(0.5) * $predicted1 * $f1y)) div $dist1_2 * ($range1 - $dist1_2) + ($start_y2 - ($y2 + sqrt(0.5) * $predicted1 * $f2y)) div $dist2_2 * ($range2 - $dist2_2) + ($start_y2 - ($y3 + sqrt(0.5) * $predicted1 * $f3y)) div $dist3_2 * ($range3 - $dist3_2)) - (($start_x2 - ($x1 + sqrt(0.5) * $predicted1 * $f1x)) div $dist1_2 * ($start_y2 - ($y1 + sqrt(0.5) * $predicted1 * $f1y)) div $dist1_2 + ($start_x2 - ($x2 + sqrt(0.5) * $predicted1 * $f2x)) div $dist2_2 * ($start_y2 - ($y2 + sqrt(0.5) * $predicted1 * $f2y)) div $dist2_2 + ($start_x2 - ($x3 + sqrt(0.5) * $predicted1 * $f3x)) div $dist3_2 * ($start_y2 - ($y3 + sqrt(0.5) * $predicted1 * $f3y)) div $dist3_2) * (($start_x2 - ($x1 + sqrt(0.5) * $predicted1 * $f1x)) div $dist1_2 * ($range1 - $dist1_2) + ($start_x2 - ($x2 + sqrt(0.5) * $predicted1 * $f2x)) div $dist2_2 * ($range2 - $dist2_2) + ($start_x2 - ($x3 + sqrt(0.5) * $predicted1 * $f3x)) div $dist3_2 * ($range3 - $dist3_2))) div ((pow(($start_x2 - ($x1 + sqrt(0.5) * $predicted1 * $f1x)) div $dist1_2, 2) + pow(($start_x2 - ($x2 + sqrt(0.5) * $predicted1 * $f2x)) div $dist2_2, 2) + pow(($start_x2 - ($x3 + sqrt(0.5) * $predicted1 * $f3x)) div $dist3_2, 2)) * (pow(($start_y2 - ($y1 + sqrt(0.5) * $predicted1 * $f1y)) div $dist1_2, 2) + pow(($start_y2 - ($y2 + sqrt(0.5) * $predicted1 * $f2y)) div $dist2_2, 2) + pow(($start_y2 - ($y3 + sqrt(0.5) * $predicted1 * $f3y)) div $dist3_2, 2)) - pow((($start_x2 - ($x1 + sqrt(0.5) * $predicted1 * $f1x)) div $dist1_2 * ($start_y2 - ($y1 + sqrt(0.5) * $predicted1 * $f1y)) div $dist1_2 + ($start_x2 - ($x2 + sqrt(0.5) * $predicted1 * $f2x)) div $dist2_2 * ($start_y2 - ($y2 + sqrt(0.5) * $predicted1 * $f2y)) div $dist2_2 + ($start_x2 - ($x3 + sqrt(0.5) * $predicted1 * $f3x)) div $dist3_2 * ($start_y2 - ($y3 + sqrt(0.5) * $predicted1 * $f3y)) div $dist3_2), 2))" unit="m" role="working"/>
              <stochcraft:output name="position_error_level_2" expression="pow($x2_est - $node_x, 2) + pow($y2_est - $node_y, 2)" unit="m²" summary="rms"/>
