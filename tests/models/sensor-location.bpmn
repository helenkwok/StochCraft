              <stochcraft:output name="start_y5" expression="(2 * (($x2 + sqrt(0.5) * $predicted4 * $f2x) - ($x1 + sqrt(0.5) * $predicted4 * $f1x)) * (pow($range1, 2) - pow($range3, 2) + pow(($x3 + sqrt(0.5) * $predicted4 * $f3x), 2) - pow(($x1 + sqrt(0.5) * $predicted4 * $f1x), 2) + pow(($y3 + sqrt(0.5) * $predicted4 * $f3y), 2) - pow(($y1 + sqrt(0.5) * $predicted4 * $f1y), 2)) - (pow($range1, 2) - pow($range2, 2) + pow(($x2 + sqrt(0.5) * $predicted4 * $f2x), 2) - pow(($x1 + sqrt(0.5) * $predicted4 * $f1x), 2) + pow(($y2 + sqrt(0.5) * $predicted4 * $f2y), 2) - pow(($y1 + sqrt(0.5) * $predicted4 * $f1y), 2)) * 2 * (($x3 + sqrt(0.5) * $predicted4 * $f3x) - ($x1 + sqrt(0.5) * $predicted4 * $f1x))) div (2 * (($x2 + sqrt(0.5) * $predicted4 * $f2x) - ($x1 + sqrt(0.5) * $predicted4 * $f1x)) * 2 * (($y3 + sqrt(0.5) * $predicted4 * $f3y) - ($y1 + sqrt(0.5) * $predicted4 * $f1y)) - 2 * (($y2 + sqrt(0.5) * $predicted4 * $f2y) - ($y1 + sqrt(0.5) * $predicted4 * $f1y)) * 2 * (($x3 + sqrt(0.5) * $predicted4 * $f3x) - ($x1 + sqrt(0.5) * $predicted4 * $f1x)))" unit="m" role="working"/>
              <stochcraft:output name="dist1_5" expression="sqrt(pow($start_x5 - ($x1 + sqrt(0.5) * $predicted4 * $f1x), 2) + pow($start_y5 - ($y1 + sqrt(0.5) * $predicted4 * $f1y), 2))" unit="m" role="working"/>
              <stochcraft:output name="dist2_5" expression="sqrt(pow($start_x5 - ($x2 + sqrt(0.5) * $predicted4 * $f2x), 2) + pow($start_y5 - ($y2 + sqrt(0.5) * $predicted4 * $f2y), 2))" unit="m" role="working"/>
              <stochcraft:output name="dist3_5" expression="sqrt(pow($start_x5 - ($x3 + sqrt(0.5) * $predicted4 * $f3x), 2) + pow($start_y5 - ($y3 + sqrt(0.5) * $predicted4 * $f3y), 2))" unit="m" role="working"/>
              <stochcraft:output name="x5_est" expression="$start_x5 + ((($start_x5 - ($x1 + sqrt(0.5) * $predicted4 * $f1x)) div $dist1_5 * ($range1 - $dist1_5) + ($start_x5 - ($x2 + sqrt(0.5) * $predicted4 * $f2x)) div $dist2_5 * ($range2 - $dist2_5) + ($start_x5 - ($x3 + sqrt(0.5) * $predicted4 * $f3x)) div $dist3_5 * ($range3 - $dist3_5)) * (pow(($start_y5 - ($y1 + sqrt(0.5) * $predicted4 * $f1y)) div $dist1_5, 2) + pow(($start_y5 - ($y2 + sqrt(0.5) * $predicted4 * $f2y)) div $dist2_5, 2) + pow(($start_y5 - ($y3 + sqrt(0.5) * $predicted4 * $f3y)) div $dist3_5, 2)) - (($start_x5 - ($x1 + sqrt(0.5) * $predicted4 * $f1x)) div $dist1_5 * ($start_y5 - ($y1 + sqrt(0.5) * $predicted4 * $f1y)) div $dist1_5 + ($start_x5 - ($x2 + sqrt(0.5) * $predicted4 * $f2x)) div $dist2_5 * ($start_y5 - ($y2 + sqrt(0.5) * $predicted4 * $f2y)) div $dist2_5 + ($start_x5 - ($x3 + sqrt(0.5) * $predicted4 * $f3x)) div $dist3_5 * ($start_y5 - ($y3 + sqrt(0.5) * $predicted4 * $f3y)) div $dist3_5) * (($start_y5 - ($y1 + sqrt(0.5) * $predicted4 * $f1y)) div $dist1_5 * ($range1 - $dist1_5) + ($start_y5 - ($y2 + sqrt(0.5) * $predicted4 * $f2y)) div $dist2_5 * ($range2 - $dist2_5) + ($start_y5 - ($y3 + sqrt(0.5) * $predicted4 * $f3y)) div $dist3_5 * ($range3 - $dist3_5))) div ((pow(($start_x5 - ($x1 + sqrt(0.5) * $predicted4 * $f1x)) div $dist1_5, 2) + pow(($start_x5 - ($x2 + sqrt(0.5) * $predicted4 * $f2x)) div $dist2_5, 2) + pow(($start_x5 - ($x3 + sqrt(0.5) * $predicted4 * $f3x)) div $dist3_5, 2)) * (pow(($start_y5 - ($y1 + sqrt(0.5) * $predicted4 * $f1y)) div $dist1_5, 2) + pow(($start_y5 - ($y2 + sqrt(0.5) * $predicted4 * $f2y)) div $dist2_5, 2) + pow(($start_y5 - ($y3 + sqrt(0.5) * $predicted4 * $f3y)) div $dist3_5, 2)) - pow((($start_x5 - ($x1 + sqrt(0.5) * $predicted4 * $f1x)) div $dist1_5 * ($start_y5 - ($y1 + sqrt(0.5) * $predicted4 * $f1y)) div $dist1_5 + ($start_x5 - ($x2 + sqrt(0.5) * $predicted4 * $f2x)) div $dist2_5 * ($start_y5 - ($y2 + sqrt(0.5) * $predicted4 * $f2y)) div $dist2_5 + ($start_x5 - ($x3 + sqrt(0.5) * $predicted4 * $f3x)) div $dist3_5 * ($start_y5 - ($y3 + sqrt(0.5) * $predicted4 * $f3y)) div $dist3_5), 2))" unit="m" role="working"/>
              <stochcraft:output name="y5_est" expression="$start_y5 + ((pow(($start_x5 - ($x1 + sqrt(0.5) * $predicted4 * $f1x)) div $dist1_5, 2) + pow(($start_x5 - ($x2 + sqrt(0.5) * $predicted4 * $f2x)) div $dist2_5, 2) + pow(($start_x5 - ($x3 + sqrt(0.5) * $predicted4 * $f3x)) div $dist3_5, 2)) * (($start_y5 - ($y1 + sqrt(0.5) * $predicted4 * $f1y)) div $dist1_5 * ($range1 - $dist1_5) + ($start_y5 - ($y2 + sqrt(0.5) * $predicted4 * $f2y)) div $dist2_5 * ($range2 - $dist2_5) + ($start_y5 - ($y3 + sqrt(0.5) * $predicted4 * $f3y)) div $dist3_5 * ($range3 - $dist3_5)) - (($start_x5 - ($x1 + sqrt(0.5) * $predicted4 * $f1x)) div $dist1_5 * ($start_y5 - ($y1 + sqrt(0.5) * $predicted4 * $f1y)) div $dist1_5 + ($start_x5 - ($x2 + sqrt(0.5) * $predicted4 * $f2x)) div $dist2_5 * ($start_y5 - ($y2 + sqrt(0.5) * $predicted4 * $f2y)) div $dist2_5 + ($start_x5 - ($x3 + sqrt(0.5) * $predicted4 * $f3x)) div $dist3_5 * ($start_y5 - ($y3 + sqrt(0.5) * $predicted4 * $f3y)) div $dist3_5) * (($start_x5 - ($x1 + sqrt(0.5) * $predicted4 * $f1x)) div $dist1_5 * ($range1 - $dist1_5) + ($start_x5 - ($x2 + sqrt(0.5) * $predicted4 * $f2x)) div $dist2_5 * ($range2 - $dist2_5) + ($start_x5 - ($x3 + sqrt(0.5) * $predicted4 * $f3x)) div $dist3_5 * ($range3 - $dist3_5))) div ((pow(($start_x5 - ($x1 + sqrt(0.5) * $predicted4 * $f1x)) div $dist1_5, 2) + pow(($start_x5 - ($x2 + sqrt(0.5) * $predicted4 * $f2x)) div $dist2_5, 2) + pow(($start_x5 - ($x3 + sqrt(0.5) * $predicted4 * $f3x)) div $dist3_5, 2)) * (pow(($start_y5 - ($y1 + sqrt(0.5) * $predicted4 * $f1y)) div $dist1_5, 2) + pow(($start_y5 - ($y2 + sqrt(0.5) * $predicted4 * $f2y)) div $dist2_5, 2) + pow(($start_y5 - ($y3 + sqrt(0.5) * $predicted4 * $f3y)) div $dist3_5, 2)) - pow((($start_x5 - ($x1 + sqrt(0.5) * $predicted4 * $f1x)) div $dist1_5 * ($start_y5 - ($y1 + sqrt(0.5) * $predicted4 * $f1y)) div $dist1_5 + ($start_x5 - ($x2 + sqrt(0.5) * $predicted4 * $f2x)) div $dist2_5 * ($start_y5 - ($y2 + sqrt(0.5) * $predicted4 * $f2y)) div $dist2_5 + ($start_x5 - ($x3 + sqrt(0.5) * $predicted4 * $f3x)) div $dist3_5 * ($start_y5 - ($y3 + sqrt(0.5) * $predicted4 * $f3y)) div $dist3_5), 2))" unit="m" role="working"/>
              <stochcraft:output name="position_error_level_5" expression="pow($x5_est - $node_x, 2) + pow($y5_est - $node_y, 2)" unit="m²" summary="rms"/>
              <stochcraft:output name="closed_form_error_level_1" expression="pow($start_x1 - $node_x, 2) + pow($start_y1 - $node_y, 2)" unit="m²" summary="rms"/>
            </stochcraft:monteCarlo>
          </bpsim:VendorExtension>
        </bpsim:Scenario>
        <bpsim:Scenario id="one-metre" name="Distance error 1 m" inherits="five-metres">
          <bpsim:ScenarioParameters>
            <bpsim:PropertyParameters>
              <bpsim:Property name="sigma_d" type="double"><bpsim:FloatingParameter value="1"/></bpsim:Property>
            </bpsim:PropertyParameters>
          </bpsim:ScenarioParameters>
        </bpsim:Scenario>
        <bpsim:Scenario id="ten-metres" name="Distance error 10 m" inherits="five-metres">
          <bpsim:ScenarioParameters>
            <bpsim:PropertyParameters>
              <bpsim:Property name="sigma_d" type="double"><bpsim:FloatingParameter value="10"/></bpsim:Property>
            </bpsim:PropertyParameters>
          </bpsim:ScenarioParameters>
        </bpsim:Scenario>
      </bpsim:BPSimData>
