<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpsim="http://www.bpsim.org/schemas/2.0" id="definitions" name="Case B (Schmitt et al. 2026)" targetNamespace="https://github.com/helenkwok/StochCraft/model" exporter="StochCraft" exporterVersion="0.1.0">
  <bpmn:resource id="raw_resource" name="Raw material"/>
  <bpmn:resource id="loading_resource" name="Loading"/>
  <bpmn:resource id="conveyor_resource" name="Conveyor"/>
  <bpmn:resource id="washing_resource" name="Washing"/>
  <bpmn:resource id="handling_resource" name="Handling"/>
  <bpmn:resource id="press1_resource" name="Press 1"/>
  <bpmn:resource id="press2_resource" name="Press 2"/>
  <bpmn:resource id="quality_resource" name="Quality"/>
  <bpmn:process id="process" name="Case B (Schmitt et al. 2026)" isExecutable="false">
    <bpmn:startEvent id="supply" name="Supply">
      <bpmn:outgoing>flow-1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="raw" name="Raw material">
      <bpmn:incoming>flow-1</bpmn:incoming>
      <bpmn:outgoing>flow-2</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>raw_resource</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:exclusiveGateway id="route" name="To a press">
      <bpmn:incoming>flow-6</bpmn:incoming>
      <bpmn:outgoing>flow-7</bpmn:outgoing>
      <bpmn:outgoing>flow-8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="inspect" name="Accepted?">
      <bpmn:incoming>flow-11</bpmn:incoming>
      <bpmn:outgoing>flow-12</bpmn:outgoing>
      <bpmn:outgoing>flow-13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="done" name="Accepted parts">
      <bpmn:incoming>flow-12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="scrap" name="Rejected parts">
      <bpmn:incoming>flow-13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="loading" name="Loading">
      <bpmn:incoming>flow-2</bpmn:incoming>
      <bpmn:outgoing>flow-3</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>loading_resource</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:task id="conveyor" name="Conveyor">
      <bpmn:incoming>flow-3</bpmn:incoming>
      <bpmn:outgoing>flow-4</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>conveyor_resource</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:task id="washing" name="Washing">
      <bpmn:incoming>flow-4</bpmn:incoming>
      <bpmn:outgoing>flow-5</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>washing_resource</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:task id="handling" name="Handling">
      <bpmn:incoming>flow-5</bpmn:incoming>
      <bpmn:outgoing>flow-6</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>handling_resource</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:task id="press1" name="Press 1">
      <bpmn:incoming>flow-7</bpmn:incoming>
      <bpmn:outgoing>flow-9</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>press1_resource</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:task id="press2" name="Press 2">
      <bpmn:incoming>flow-8</bpmn:incoming>
      <bpmn:outgoing>flow-10</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>press2_resource</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:task id="quality" name="Quality">
      <bpmn:incoming>flow-9</bpmn:incoming>
      <bpmn:incoming>flow-10</bpmn:incoming>
      <bpmn:outgoing>flow-11</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>quality_resource</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow-1" sourceRef="supply" targetRef="raw"/>
    <bpmn:sequenceFlow id="flow-2" sourceRef="raw" targetRef="loading"/>
    <bpmn:sequenceFlow id="flow-3" sourceRef="loading" targetRef="conveyor"/>
    <bpmn:sequenceFlow id="flow-4" sourceRef="conveyor" targetRef="washing"/>
    <bpmn:sequenceFlow id="flow-5" sourceRef="washing" targetRef="handling"/>
    <bpmn:sequenceFlow id="flow-6" sourceRef="handling" targetRef="route"/>
    <bpmn:sequenceFlow id="flow-7" sourceRef="route" targetRef="press1"/>
    <bpmn:sequenceFlow id="flow-8" sourceRef="route" targetRef="press2"/>
    <bpmn:sequenceFlow id="flow-9" sourceRef="press1" targetRef="quality"/>
    <bpmn:sequenceFlow id="flow-10" sourceRef="press2" targetRef="quality"/>
    <bpmn:sequenceFlow id="flow-11" sourceRef="quality" targetRef="inspect"/>
    <bpmn:sequenceFlow id="flow-12" sourceRef="inspect" targetRef="done"/>
    <bpmn:sequenceFlow id="flow-13" sourceRef="inspect" targetRef="scrap"/>
