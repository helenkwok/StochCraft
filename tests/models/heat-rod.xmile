  <header>
    <name>Heat in a rod</name>
    <vendor>StochCraft</vendor>
    <product version="0.2">StochCraft</product>
  </header>
  <sim_specs method="RK4">
    <start>0</start>
    <stop>0.1</stop>
    <dt>2.5e-05</dt>
    <stochcraft:save_step>0.0005</stochcraft:save_step>
    <stochcraft:stop_when variable="u10" above="10000"/>
  </sim_specs>
