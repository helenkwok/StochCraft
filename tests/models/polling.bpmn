<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpsim="http://www.bpsim.org/schemas/2.0" id="definitions" name="Polling place" targetNamespace="https://github.com/helenkwok/StochCraft/model" exporter="StochCraft" exporterVersion="0.2.0">
  <bpmn:resource id="machines_resource" name="Voting machines"/>
  <bpmn:process id="process" name="Polling place" isExecutable="false">
    <bpmn:startEvent id="voters" name="Voters arrive">
      <bpmn:outgoing>flow-1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="machines" name="Voting machines">
      <bpmn:incoming>flow-1</bpmn:incoming>
      <bpmn:outgoing>flow-2</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>machines_resource</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:endEvent id="voted" name="Voters leave">
      <bpmn:incoming>flow-2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow-1" sourceRef="voters" targetRef="machines"/>
    <bpmn:sequenceFlow id="flow-2" sourceRef="machines" targetRef="voted"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="process">
      <bpmndi:BPMNShape id="voters_di" bpmnElement="voters">
        <dc:Bounds x="82" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="machines_di" bpmnElement="machines">
        <dc:Bounds x="230" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="voted_di" bpmnElement="voted">
        <dc:Bounds x="442" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-1_di" bpmnElement="flow-1">
        <di:waypoint x="118" y="100"/>
        <di:waypoint x="230" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-2_di" bpmnElement="flow-2">
        <di:waypoint x="330" y="100"/>
        <di:waypoint x="442" y="100"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmn:relationship type="BPSimData">
    <bpmn:extensionElements>
      <bpsim:BPSimData>
        <bpsim:Scenario id="scenario" name="Long ballot, 18 machines" vendor="StochCraft" version="0.2.0">
          <bpsim:ScenarioParameters replication="10" seed="1" baseTimeUnit="min">
            <bpsim:Duration>
              <bpsim:FloatingParameter value="20600"/>
            </bpsim:Duration>
            <bpsim:Warmup>
              <bpsim:FloatingParameter value="600"/>
            </bpsim:Warmup>
          </bpsim:ScenarioParameters>
          <bpsim:ElementParameters elementRef="voters">
            <bpsim:ControlParameters>
              <bpsim:InterTriggerTimer>
                <bpsim:NegativeExponentialDistribution mean="0.8333333333333334"/>
              </bpsim:InterTriggerTimer>
            </bpsim:ControlParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="machines">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NegativeExponentialDistribution mean="12.5"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ExpressionParameter value="getResource('machines_resource', 1)"/>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="machines_resource">
            <bpsim:ResourceParameters>
              <bpsim:Quantity>
                <bpsim:NumericParameter value="18"/>
              </bpsim:Quantity>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
        </bpsim:Scenario>
        <bpsim:Scenario id="16-machines" name="Long ballot, 16 machines" inherits="scenario">
          <bpsim:ElementParameters elementRef="machines_resource">
            <bpsim:ResourceParameters>
              <bpsim:Quantity>
                <bpsim:NumericParameter value="16"/>
              </bpsim:Quantity>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
        </bpsim:Scenario>
        <bpsim:Scenario id="short-ballot" name="Short ballot, 10 machines" inherits="scenario">
          <bpsim:ElementParameters elementRef="machines">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NegativeExponentialDistribution mean="6.5"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="machines_resource">
            <bpsim:ResourceParameters>
              <bpsim:Quantity>
                <bpsim:NumericParameter value="10"/>
              </bpsim:Quantity>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
        </bpsim:Scenario>
        <bpsim:Scenario id="election-day" name="Election day, 18 machines" inherits="scenario">
          <bpsim:ScenarioParameters replication="200">
            <bpsim:Duration>
              <bpsim:FloatingParameter value="2880"/>
            </bpsim:Duration>
            <bpsim:Warmup>
              <bpsim:FloatingParameter value="0"/>
            </bpsim:Warmup>
          </bpsim:ScenarioParameters>
          <bpsim:ElementParameters elementRef="voters">
            <bpsim:ControlParameters>
              <bpsim:TriggerCount>
                <bpsim:NumericParameter value="936"/>
              </bpsim:TriggerCount>
            </bpsim:ControlParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="voted">
            <bpsim:VendorExtension name="stochcraft:stopCount" xmlns:stochcraft="https://helenkwok.github.io/StochCraft/bpsim/1" stochcraft:value="936"/>
          </bpsim:ElementParameters>
        </bpsim:Scenario>
        <bpsim:Scenario id="election-day-14-machines" name="Election day, 14 machines" inherits="election-day">
          <bpsim:ElementParameters elementRef="machines_resource">
            <bpsim:ResourceParameters>
              <bpsim:Quantity>
                <bpsim:NumericParameter value="14"/>
              </bpsim:Quantity>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
        </bpsim:Scenario>
      </bpsim:BPSimData>
    </bpmn:extensionElements>
    <bpmn:source>definitions</bpmn:source>
    <bpmn:target>definitions</bpmn:target>
  </bpmn:relationship>
</bpmn:definitions>
