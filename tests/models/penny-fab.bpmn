<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpsim="http://www.bpsim.org/schemas/2.0" id="definitions" name="Penny Fab" targetNamespace="https://github.com/helenkwok/StochCraft/model" exporter="StochCraft" exporterVersion="0.2.0">
  <bpmn:resource id="head_resource" name="Head stamping"/>
  <bpmn:resource id="tail_resource" name="Tail stamping"/>
  <bpmn:resource id="rim_resource" name="Rimming"/>
  <bpmn:resource id="deburr_resource" name="Deburring"/>
  <bpmn:process id="process" name="Penny Fab" isExecutable="false">
    <bpmn:task id="head" name="Head stamping">
      <bpmn:incoming>flow-4</bpmn:incoming>
      <bpmn:outgoing>flow-1</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>head_resource</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:task id="tail" name="Tail stamping">
      <bpmn:incoming>flow-1</bpmn:incoming>
      <bpmn:outgoing>flow-2</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>tail_resource</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:task id="rim" name="Rimming">
      <bpmn:incoming>flow-2</bpmn:incoming>
      <bpmn:outgoing>flow-3</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>rim_resource</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:task id="deburr" name="Deburring">
      <bpmn:incoming>flow-3</bpmn:incoming>
      <bpmn:outgoing>flow-4</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>deburr_resource</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow-1" sourceRef="head" targetRef="tail"/>
    <bpmn:sequenceFlow id="flow-2" sourceRef="tail" targetRef="rim"/>
    <bpmn:sequenceFlow id="flow-3" sourceRef="rim" targetRef="deburr"/>
    <bpmn:sequenceFlow id="flow-4" sourceRef="deburr" targetRef="head"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="process">
      <bpmndi:BPMNShape id="head_di" bpmnElement="head">
        <dc:Bounds x="80" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tail_di" bpmnElement="tail">
        <dc:Bounds x="260" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rim_di" bpmnElement="rim">
        <dc:Bounds x="440" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="deburr_di" bpmnElement="deburr">
        <dc:Bounds x="620" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-1_di" bpmnElement="flow-1">
        <di:waypoint x="180" y="100"/>
        <di:waypoint x="260" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-2_di" bpmnElement="flow-2">
        <di:waypoint x="360" y="100"/>
        <di:waypoint x="440" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-3_di" bpmnElement="flow-3">
        <di:waypoint x="540" y="100"/>
        <di:waypoint x="620" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-4_di" bpmnElement="flow-4">
        <di:waypoint x="670" y="140"/>
        <di:waypoint x="670" y="200"/>
        <di:waypoint x="130" y="200"/>
        <di:waypoint x="130" y="140"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmn:relationship type="BPSimData">
    <bpmn:extensionElements>
      <bpsim:BPSimData>
        <bpsim:Scenario id="scenario" name="4 jobs (the critical WIP)" vendor="StochCraft" version="0.2.0">
          <bpsim:ScenarioParameters replication="10" seed="1" baseTimeUnit="hour">
            <bpsim:Duration>
              <bpsim:FloatingParameter value="20500"/>
            </bpsim:Duration>
            <bpsim:Warmup>
              <bpsim:FloatingParameter value="500"/>
            </bpsim:Warmup>
          </bpsim:ScenarioParameters>
          <bpsim:ElementParameters elementRef="head">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NegativeExponentialDistribution mean="2"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ExpressionParameter value="getResource('head_resource', 1)"/>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
            <bpsim:VendorExtension name="stochcraft:startingContents" xmlns:stochcraft="https://helenkwok.github.io/StochCraft/bpsim/1" stochcraft:value="4"/>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="tail">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NegativeExponentialDistribution mean="2"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ExpressionParameter value="getResource('tail_resource', 1)"/>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="rim">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NegativeExponentialDistribution mean="2"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ExpressionParameter value="getResource('rim_resource', 1)"/>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="deburr">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NegativeExponentialDistribution mean="2"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ExpressionParameter value="getResource('deburr_resource', 1)"/>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="head_resource">
            <bpsim:ResourceParameters>
              <bpsim:Quantity>
                <bpsim:NumericParameter value="1"/>
              </bpsim:Quantity>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="tail_resource">
            <bpsim:ResourceParameters>
              <bpsim:Quantity>
                <bpsim:NumericParameter value="1"/>
              </bpsim:Quantity>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="rim_resource">
            <bpsim:ResourceParameters>
              <bpsim:Quantity>
                <bpsim:NumericParameter value="1"/>
              </bpsim:Quantity>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="deburr_resource">
            <bpsim:ResourceParameters>
              <bpsim:Quantity>
                <bpsim:NumericParameter value="1"/>
              </bpsim:Quantity>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
        </bpsim:Scenario>
        <bpsim:Scenario id="1-job" name="1 job" inherits="scenario">
          <bpsim:ElementParameters elementRef="head">
            <bpsim:VendorExtension name="stochcraft:startingContents" xmlns:stochcraft="https://helenkwok.github.io/StochCraft/bpsim/1" stochcraft:value="1"/>
          </bpsim:ElementParameters>
        </bpsim:Scenario>
        <bpsim:Scenario id="8-jobs" name="8 jobs" inherits="scenario">
          <bpsim:ElementParameters elementRef="head">
            <bpsim:VendorExtension name="stochcraft:startingContents" xmlns:stochcraft="https://helenkwok.github.io/StochCraft/bpsim/1" stochcraft:value="8"/>
          </bpsim:ElementParameters>
        </bpsim:Scenario>
        <bpsim:Scenario id="16-jobs" name="16 jobs" inherits="scenario">
          <bpsim:ElementParameters elementRef="head">
            <bpsim:VendorExtension name="stochcraft:startingContents" xmlns:stochcraft="https://helenkwok.github.io/StochCraft/bpsim/1" stochcraft:value="16"/>
          </bpsim:ElementParameters>
        </bpsim:Scenario>
        <bpsim:Scenario id="fixed-times" name="4 jobs, fixed times (best case)" inherits="scenario">
          <bpsim:ElementParameters elementRef="head">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:FloatingParameter value="2"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="tail">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:FloatingParameter value="2"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="rim">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:FloatingParameter value="2"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="deburr">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:FloatingParameter value="2"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
          </bpsim:ElementParameters>
        </bpsim:Scenario>
      </bpsim:BPSimData>
    </bpmn:extensionElements>
    <bpmn:source>definitions</bpmn:source>
    <bpmn:target>definitions</bpmn:target>
  </bpmn:relationship>
</bpmn:definitions>
