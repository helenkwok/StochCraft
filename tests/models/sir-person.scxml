<?xml version="1.0" encoding="UTF-8"?>
<!-- The state chart of a person in sir-agents.bpmn (MIT OR Apache-2.0): W3C SCXML 1.0 with
     StochCraft's stochcraft data model and extensions. The first person (serial 0) starts
     infected and the rest susceptible. An infected person meets a random other person at rate
     1.5 a day (a `contact` message, which infects a susceptible one and is dropped by anyone
     else) and recovers at rate 1 a day. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml"
    xmlns:stochcraft="https://helenkwok.github.io/StochCraft/scxml/1"
    version="1.0" datamodel="stochcraft" name="person">
  <state id="start">
    <transition cond="serial() = 0" target="infected"/>
    <transition target="susceptible"/>
  </state>
  <state id="susceptible">
    <transition event="contact" target="infected"/>
  </state>
  <state id="infected">
    <onentry>
      <send event="talk" id="talk_timer" delayexpr="exponential(1 div (1.5))" stochcraft:rate="1.5"/>
      <send event="recover" delayexpr="exponential(1 div (1))" stochcraft:rate="1"/>
    </onentry>
    <onexit>
      <cancel sendid="talk_timer"/>
    </onexit>
    <transition event="talk">
      <send event="contact" type="https://helenkwok.github.io/StochCraft/scxml/1#agents"
          stochcraft:to="random" stochcraft:population="people"/>
      <send event="talk" delayexpr="exponential(1 div (1.5))" stochcraft:rate="1.5"/>
    </transition>
    <transition event="recover" target="recovered"/>
  </state>
  <state id="recovered"/>
</scxml>
