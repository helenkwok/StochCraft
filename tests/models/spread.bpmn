<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpsim="http://www.bpsim.org/schemas/2.0" id="definitions" name="Same mean, different spread" targetNamespace="https://github.com/helenkwok/StochCraft/model" exporter="StochCraft" exporterVersion="0.2.0">
  <bpmn:resource id="fixed_resource" name="A: always 1 minute"/>
  <bpmn:resource id="random_resource" name="B: random, mean 1 minute"/>
  <bpmn:resource id="uneven_resource" name="C: very uneven, mean 1 minute"/>
  <bpmn:resource id="workstation_resource" name="Workstation"/>
  <bpmn:process id="process" name="Same mean, different spread" isExecutable="false">
    <bpmn:startEvent id="fixed_in" name="Jobs arrive at A">
      <bpmn:outgoing>flow-1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="fixed" name="A: always 1 minute">
      <bpmn:incoming>flow-1</bpmn:incoming>
      <bpmn:outgoing>flow-2</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>fixed_resource</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:endEvent id="fixed_out" name="Jobs leave A">
      <bpmn:incoming>flow-2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="random_in" name="Jobs arrive at B">
      <bpmn:outgoing>flow-3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="random" name="B: random, mean 1 minute">
      <bpmn:incoming>flow-3</bpmn:incoming>
      <bpmn:outgoing>flow-4</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>random_resource</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:endEvent id="random_out" name="Jobs leave B">
      <bpmn:incoming>flow-4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="uneven_in" name="Jobs arrive at C">
      <bpmn:outgoing>flow-5</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="uneven" name="C: very uneven, mean 1 minute">
      <bpmn:incoming>flow-5</bpmn:incoming>
      <bpmn:outgoing>flow-6</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>uneven_resource</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:endEvent id="uneven_out" name="Jobs leave C">
      <bpmn:incoming>flow-6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="workstation_in" name="Jobs arrive at the workstation">
      <bpmn:outgoing>flow-7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="workstation" name="Workstation: 3 to 8 minutes">
      <bpmn:incoming>flow-7</bpmn:incoming>
      <bpmn:outgoing>flow-8</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>workstation_resource</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:endEvent id="workstation_out" name="Jobs leave the workstation">
      <bpmn:incoming>flow-8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow-1" sourceRef="fixed_in" targetRef="fixed"/>
    <bpmn:sequenceFlow id="flow-2" sourceRef="fixed" targetRef="fixed_out"/>
    <bpmn:sequenceFlow id="flow-3" sourceRef="random_in" targetRef="random"/>
    <bpmn:sequenceFlow id="flow-4" sourceRef="random" targetRef="random_out"/>
    <bpmn:sequenceFlow id="flow-5" sourceRef="uneven_in" targetRef="uneven"/>
    <bpmn:sequenceFlow id="flow-6" sourceRef="uneven" targetRef="uneven_out"/>
    <bpmn:sequenceFlow id="flow-7" sourceRef="workstation_in" targetRef="workstation"/>
    <bpmn:sequenceFlow id="flow-8" sourceRef="workstation" targetRef="workstation_out"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="process">
      <bpmndi:BPMNShape id="fixed_in_di" bpmnElement="fixed_in">
        <dc:Bounds x="82" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fixed_di" bpmnElement="fixed">
        <dc:Bounds x="230" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fixed_out_di" bpmnElement="fixed_out">
        <dc:Bounds x="442" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="random_in_di" bpmnElement="random_in">
        <dc:Bounds x="82" y="222" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="random_di" bpmnElement="random">
        <dc:Bounds x="230" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="random_out_di" bpmnElement="random_out">
        <dc:Bounds x="442" y="222" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="uneven_in_di" bpmnElement="uneven_in">
        <dc:Bounds x="82" y="362" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="uneven_di" bpmnElement="uneven">
        <dc:Bounds x="230" y="340" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="uneven_out_di" bpmnElement="uneven_out">
        <dc:Bounds x="442" y="362" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="workstation_in_di" bpmnElement="workstation_in">
        <dc:Bounds x="82" y="502" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="workstation_di" bpmnElement="workstation">
        <dc:Bounds x="230" y="480" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="workstation_out_di" bpmnElement="workstation_out">
        <dc:Bounds x="442" y="502" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-1_di" bpmnElement="flow-1">
        <di:waypoint x="118" y="100"/>
        <di:waypoint x="230" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-2_di" bpmnElement="flow-2">
        <di:waypoint x="330" y="100"/>
        <di:waypoint x="442" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-3_di" bpmnElement="flow-3">
        <di:waypoint x="118" y="240"/>
        <di:waypoint x="230" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-4_di" bpmnElement="flow-4">
        <di:waypoint x="330" y="240"/>
        <di:waypoint x="442" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-5_di" bpmnElement="flow-5">
        <di:waypoint x="118" y="380"/>
        <di:waypoint x="230" y="380"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-6_di" bpmnElement="flow-6">
        <di:waypoint x="330" y="380"/>
        <di:waypoint x="442" y="380"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-7_di" bpmnElement="flow-7">
        <di:waypoint x="118" y="520"/>
        <di:waypoint x="230" y="520"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-8_di" bpmnElement="flow-8">
        <di:waypoint x="330" y="520"/>
        <di:waypoint x="442" y="520"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmn:relationship type="BPSimData">
    <bpmn:extensionElements>
      <bpsim:BPSimData>
        <bpsim:Scenario id="scenario" name="Same mean, different spread" vendor="StochCraft" version="0.2.0">
          <bpsim:ScenarioParameters replication="10" seed="1" baseTimeUnit="min">
            <bpsim:Duration>
              <bpsim:FloatingParameter value="21000"/>
            </bpsim:Duration>
            <bpsim:Warmup>
              <bpsim:FloatingParameter value="1000"/>
            </bpsim:Warmup>
          </bpsim:ScenarioParameters>
          <bpsim:ElementParameters elementRef="fixed_in">
            <bpsim:ControlParameters>
              <bpsim:InterTriggerTimer>
                <bpsim:NegativeExponentialDistribution mean="1.25"/>
              </bpsim:InterTriggerTimer>
            </bpsim:ControlParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="fixed">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:FloatingParameter value="1"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ExpressionParameter value="getResource('fixed_resource', 1)"/>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="random_in">
            <bpsim:ControlParameters>
              <bpsim:InterTriggerTimer>
                <bpsim:NegativeExponentialDistribution mean="1.25"/>
              </bpsim:InterTriggerTimer>
            </bpsim:ControlParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="random">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NegativeExponentialDistribution mean="1"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ExpressionParameter value="getResource('random_resource', 1)"/>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="uneven_in">
            <bpsim:ControlParameters>
              <bpsim:InterTriggerTimer>
                <bpsim:NegativeExponentialDistribution mean="1.25"/>
              </bpsim:InterTriggerTimer>
            </bpsim:ControlParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="uneven">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:GammaDistribution shape="0.25" scale="4"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ExpressionParameter value="getResource('uneven_resource', 1)"/>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="workstation_in">
            <bpsim:ControlParameters>
              <bpsim:InterTriggerTimer>
                <bpsim:NegativeExponentialDistribution mean="6"/>
              </bpsim:InterTriggerTimer>
              <bpsim:TriggerCount>
                <bpsim:NumericParameter value="0"/>
              </bpsim:TriggerCount>
            </bpsim:ControlParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="workstation">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:TriangularDistribution mode="4" min="3" max="8"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ExpressionParameter value="getResource('workstation_resource', 1)"/>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="workstation_resource">
            <bpsim:ResourceParameters>
              <bpsim:Quantity>
                <bpsim:NumericParameter value="1"/>
              </bpsim:Quantity>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="fixed_resource">
            <bpsim:ResourceParameters>
              <bpsim:Quantity>
                <bpsim:NumericParameter value="1"/>
              </bpsim:Quantity>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="random_resource">
            <bpsim:ResourceParameters>
              <bpsim:Quantity>
                <bpsim:NumericParameter value="1"/>
              </bpsim:Quantity>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="uneven_resource">
            <bpsim:ResourceParameters>
              <bpsim:Quantity>
                <bpsim:NumericParameter value="1"/>
              </bpsim:Quantity>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
        </bpsim:Scenario>
        <bpsim:Scenario id="workstation-mg1" name="Workstation: one job every 6 minutes, 3 to 8 minutes each" inherits="scenario">
          <bpsim:ScenarioParameters replication="30">
            <bpsim:Warmup>
              <bpsim:FloatingParameter value="2000"/>
            </bpsim:Warmup>
            <bpsim:Duration>
              <bpsim:FloatingParameter value="12080"/>
            </bpsim:Duration>
          </bpsim:ScenarioParameters>
          <bpsim:ElementParameters elementRef="workstation_in">
            <bpsim:ControlParameters>
              <bpsim:TriggerCount>
                <bpsim:NumericParameter value="1000000"/>
              </bpsim:TriggerCount>
            </bpsim:ControlParameters>
          </bpsim:ElementParameters>
        </bpsim:Scenario>
      </bpsim:BPSimData>
    </bpmn:extensionElements>
    <bpmn:source>definitions</bpmn:source>
    <bpmn:target>definitions</bpmn:target>
  </bpmn:relationship>
</bpmn:definitions>
