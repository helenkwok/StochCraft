<?xml version="1.0" encoding="UTF-8"?>
<!-- A job shop short of workers (Maggard, Lesso, Hogg and Phillips, Proceedings of the 1973 Winter Simulation Conference, pp. 274-288): two machines and one worker, and each job needs its machine and the worker at the same time. Jobs arrive at rate 1 and go to either machine with chance 1/2; a job takes an exponential time of mean 0.75 with its machine and the worker. Each task has two resource roles (performers), each with its own BPSim selection: the task needs both at once. Served first come first served, the worker is the only constraint, so the shop is a single-server queue (M/M/1) at rho = 0.75; a second scenario has rho = 0.9. crates/engine/tests/examples.rs checks the model against M/M/1. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpsim="http://www.bpsim.org/schemas/2.0" id="definitions" name="A job shop short of workers" targetNamespace="https://github.com/helenkwok/StochCraft/model" exporter="StochCraft" exporterVersion="0.2.0">
  <bpmn:resource id="machine1" name="Machine 1"/>
  <bpmn:resource id="machine2" name="Machine 2"/>
  <bpmn:resource id="worker" name="Worker"/>
  <bpmn:process id="process" name="A job shop short of workers" isExecutable="false">
    <bpmn:startEvent id="jobs" name="Jobs arrive">
      <bpmn:outgoing>flow-1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="route" name="Which machine?">
      <bpmn:incoming>flow-1</bpmn:incoming>
      <bpmn:outgoing>flow-2</bpmn:outgoing>
      <bpmn:outgoing>flow-3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="job1" name="Job on machine 1">
      <bpmn:incoming>flow-2</bpmn:incoming>
      <bpmn:outgoing>flow-4</bpmn:outgoing>
      <bpmn:performer id="job1_need1">
        <bpmn:resourceRef>machine1</bpmn:resourceRef>
      </bpmn:performer>
      <bpmn:performer id="job1_need2">
        <bpmn:resourceRef>worker</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:task id="job2" name="Job on machine 2">
      <bpmn:incoming>flow-3</bpmn:incoming>
      <bpmn:outgoing>flow-5</bpmn:outgoing>
      <bpmn:performer id="job2_need1">
        <bpmn:resourceRef>machine2</bpmn:resourceRef>
      </bpmn:performer>
      <bpmn:performer id="job2_need2">
        <bpmn:resourceRef>worker</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:endEvent id="done" name="Jobs done">
      <bpmn:incoming>flow-4</bpmn:incoming>
      <bpmn:incoming>flow-5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow-1" sourceRef="jobs" targetRef="route"/>
    <bpmn:sequenceFlow id="flow-2" sourceRef="route" targetRef="job1"/>
    <bpmn:sequenceFlow id="flow-3" sourceRef="route" targetRef="job2"/>
    <bpmn:sequenceFlow id="flow-4" sourceRef="job1" targetRef="done"/>
    <bpmn:sequenceFlow id="flow-5" sourceRef="job2" targetRef="done"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="process">
      <bpmndi:BPMNShape id="jobs_di" bpmnElement="jobs">
        <dc:Bounds x="82" y="142" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="route_di" bpmnElement="route">
        <dc:Bounds x="190" y="135" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="job1_di" bpmnElement="job1">
        <dc:Bounds x="320" y="40" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="job2_di" bpmnElement="job2">
        <dc:Bounds x="320" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="done_di" bpmnElement="done">
        <dc:Bounds x="502" y="142" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-1_di" bpmnElement="flow-1">
        <di:waypoint x="118" y="160"/>
        <di:waypoint x="190" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-2_di" bpmnElement="flow-2">
        <di:waypoint x="215" y="135"/>
        <di:waypoint x="215" y="80"/>
        <di:waypoint x="320" y="80"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-3_di" bpmnElement="flow-3">
        <di:waypoint x="215" y="185"/>
        <di:waypoint x="215" y="240"/>
        <di:waypoint x="320" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-4_di" bpmnElement="flow-4">
        <di:waypoint x="420" y="80"/>
        <di:waypoint x="520" y="80"/>
        <di:waypoint x="520" y="142"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-5_di" bpmnElement="flow-5">
        <di:waypoint x="420" y="240"/>
        <di:waypoint x="520" y="240"/>
        <di:waypoint x="520" y="178"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmn:relationship type="BPSimData">
    <bpmn:extensionElements>
      <bpsim:BPSimData>
        <bpsim:Scenario id="scenario" name="Worker 75% busy" vendor="StochCraft" version="0.2.0">
          <bpsim:ScenarioParameters replication="10" seed="1" baseTimeUnit="hour">
            <bpsim:Duration>
              <bpsim:FloatingParameter value="21000"/>
            </bpsim:Duration>
            <bpsim:Warmup>
              <bpsim:FloatingParameter value="1000"/>
            </bpsim:Warmup>
          </bpsim:ScenarioParameters>
          <bpsim:ElementParameters elementRef="jobs">
            <bpsim:ControlParameters>
              <bpsim:InterTriggerTimer>
                <bpsim:NegativeExponentialDistribution mean="1"/>
              </bpsim:InterTriggerTimer>
            </bpsim:ControlParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="job1">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NegativeExponentialDistribution mean="0.75"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="job1_need1">
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ExpressionParameter value="getResource('machine1', 1)"/>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="job1_need2">
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ExpressionParameter value="getResource('worker', 1)"/>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="job2">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NegativeExponentialDistribution mean="0.75"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="job2_need1">
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ExpressionParameter value="getResource('machine2', 1)"/>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="job2_need2">
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ExpressionParameter value="getResource('worker', 1)"/>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="flow-2">
            <bpsim:ControlParameters>
              <bpsim:Probability>
                <bpsim:FloatingParameter value="0.5"/>
              </bpsim:Probability>
            </bpsim:ControlParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="flow-3">
            <bpsim:ControlParameters>
              <bpsim:Probability>
                <bpsim:FloatingParameter value="0.5"/>
              </bpsim:Probability>
            </bpsim:ControlParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="machine1">
            <bpsim:ResourceParameters>
              <bpsim:Quantity>
                <bpsim:NumericParameter value="1"/>
              </bpsim:Quantity>
            </bpsim:ResourceParameters>
            <bpsim:VendorExtension name="stochcraft:pool" xmlns:stochcraft="https://helenkwok.github.io/StochCraft/bpsim/1" stochcraft:value="true"/>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="machine2">
            <bpsim:ResourceParameters>
              <bpsim:Quantity>
                <bpsim:NumericParameter value="1"/>
              </bpsim:Quantity>
            </bpsim:ResourceParameters>
            <bpsim:VendorExtension name="stochcraft:pool" xmlns:stochcraft="https://helenkwok.github.io/StochCraft/bpsim/1" stochcraft:value="true"/>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="worker">
            <bpsim:ResourceParameters>
              <bpsim:Quantity>
                <bpsim:NumericParameter value="1"/>
              </bpsim:Quantity>
            </bpsim:ResourceParameters>
            <bpsim:VendorExtension name="stochcraft:pool" xmlns:stochcraft="https://helenkwok.github.io/StochCraft/bpsim/1" stochcraft:value="true"/>
          </bpsim:ElementParameters>
        </bpsim:Scenario>
        <bpsim:Scenario id="busier" name="Worker 90% busy" inherits="scenario">
          <bpsim:ElementParameters elementRef="job1">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NegativeExponentialDistribution mean="0.9"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="job2">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NegativeExponentialDistribution mean="0.9"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
          </bpsim:ElementParameters>
        </bpsim:Scenario>
      </bpsim:BPSimData>
    </bpmn:extensionElements>
    <bpmn:source>definitions</bpmn:source>
    <bpmn:target>definitions</bpmn:target>
  </bpmn:relationship>
</bpmn:definitions>
