<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpsim="http://www.bpsim.org/schemas/2.0" id="definitions" name="Project finish date" targetNamespace="https://github.com/helenkwok/StochCraft/model" exporter="StochCraft" exporterVersion="0.2.0">
  <bpmn:process id="process" name="Project finish date" isExecutable="false">
    <bpmn:startEvent id="start" name="Project starts">
      <bpmn:outgoing>flow-1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="split" name="Start all three">
      <bpmn:incoming>flow-1</bpmn:incoming>
      <bpmn:outgoing>flow-2</bpmn:outgoing>
      <bpmn:outgoing>flow-3</bpmn:outgoing>
      <bpmn:outgoing>flow-4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="design" name="Design">
      <bpmn:incoming>flow-2</bpmn:incoming>
      <bpmn:outgoing>flow-5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="permits" name="Permits">
      <bpmn:incoming>flow-3</bpmn:incoming>
      <bpmn:outgoing>flow-6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="materials" name="Materials">
      <bpmn:incoming>flow-4</bpmn:incoming>
      <bpmn:outgoing>flow-7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="join" name="All three done">
      <bpmn:incoming>flow-5</bpmn:incoming>
      <bpmn:incoming>flow-6</bpmn:incoming>
      <bpmn:incoming>flow-7</bpmn:incoming>
      <bpmn:outgoing>flow-8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="finished" name="Project finished">
      <bpmn:incoming>flow-8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow-1" sourceRef="start" targetRef="split"/>
    <bpmn:sequenceFlow id="flow-2" sourceRef="split" targetRef="design"/>
    <bpmn:sequenceFlow id="flow-3" sourceRef="split" targetRef="permits"/>
    <bpmn:sequenceFlow id="flow-4" sourceRef="split" targetRef="materials"/>
    <bpmn:sequenceFlow id="flow-5" sourceRef="design" targetRef="join"/>
    <bpmn:sequenceFlow id="flow-6" sourceRef="permits" targetRef="join"/>
    <bpmn:sequenceFlow id="flow-7" sourceRef="materials" targetRef="join"/>
    <bpmn:sequenceFlow id="flow-8" sourceRef="join" targetRef="finished"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="process">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="82" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="split_di" bpmnElement="split">
        <dc:Bounds x="255" y="75" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="design_di" bpmnElement="design">
        <dc:Bounds x="410" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="permits_di" bpmnElement="permits">
        <dc:Bounds x="410" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="materials_di" bpmnElement="materials">
        <dc:Bounds x="410" y="340" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="join_di" bpmnElement="join">
        <dc:Bounds x="615" y="75" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="finished_di" bpmnElement="finished">
        <dc:Bounds x="802" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-1_di" bpmnElement="flow-1">
        <di:waypoint x="118" y="100"/>
        <di:waypoint x="255" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-2_di" bpmnElement="flow-2">
        <di:waypoint x="305" y="100"/>
        <di:waypoint x="410" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-3_di" bpmnElement="flow-3">
        <di:waypoint x="305" y="100"/>
        <di:waypoint x="410" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-4_di" bpmnElement="flow-4">
        <di:waypoint x="305" y="100"/>
        <di:waypoint x="410" y="380"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-5_di" bpmnElement="flow-5">
        <di:waypoint x="510" y="100"/>
        <di:waypoint x="615" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-6_di" bpmnElement="flow-6">
        <di:waypoint x="510" y="240"/>
        <di:waypoint x="615" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-7_di" bpmnElement="flow-7">
        <di:waypoint x="510" y="380"/>
        <di:waypoint x="615" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-8_di" bpmnElement="flow-8">
        <di:waypoint x="665" y="100"/>
        <di:waypoint x="802" y="100"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmn:relationship type="BPSimData">
    <bpmn:extensionElements>
      <bpsim:BPSimData>
        <bpsim:Scenario id="scenario" name="Project finish date" vendor="StochCraft" version="0.2.0">
          <bpsim:ScenarioParameters replication="200" seed="1" baseTimeUnit="day">
            <bpsim:Duration>
              <bpsim:FloatingParameter value="1000"/>
            </bpsim:Duration>
          </bpsim:ScenarioParameters>
          <bpsim:ElementParameters elementRef="start">
            <bpsim:ControlParameters>
              <bpsim:InterTriggerTimer>
                <bpsim:FloatingParameter value="0"/>
              </bpsim:InterTriggerTimer>
              <bpsim:TriggerCount>
                <bpsim:NumericParameter value="1"/>
              </bpsim:TriggerCount>
            </bpsim:ControlParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="design">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NegativeExponentialDistribution mean="10"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="permits">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NegativeExponentialDistribution mean="10"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="materials">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NegativeExponentialDistribution mean="10"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="finished">
            <bpsim:VendorExtension name="stochcraft:stopCount" xmlns:stochcraft="https://helenkwok.github.io/StochCraft/bpsim/1" stochcraft:value="1"/>
          </bpsim:ElementParameters>
        </bpsim:Scenario>
      </bpsim:BPSimData>
    </bpmn:extensionElements>
    <bpmn:source>definitions</bpmn:source>
    <bpmn:target>definitions</bpmn:target>
  </bpmn:relationship>
</bpmn:definitions>
