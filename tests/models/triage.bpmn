<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpsim="http://www.bpsim.org/schemas/2.0" id="definitions" name="Emergency triage" targetNamespace="https://github.com/helenkwok/StochCraft/model" exporter="StochCraft" exporterVersion="0.1.0">
  <bpmn:resource id="nurses" name="Nurses"/>
  <bpmn:process id="process" name="Emergency triage" isExecutable="false">
    <bpmn:startEvent id="patients" name="Patients arrive">
      <bpmn:outgoing>flow-1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="triage" name="Triage">
      <bpmn:incoming>flow-1</bpmn:incoming>
      <bpmn:outgoing>flow-2</bpmn:outgoing>
      <bpmn:outgoing>flow-3</bpmn:outgoing>
      <bpmn:outgoing>flow-4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="urgent" name="Urgent">
      <bpmn:incoming>flow-2</bpmn:incoming>
      <bpmn:outgoing>flow-5</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>nurses</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:task id="standard" name="Standard">
      <bpmn:incoming>flow-3</bpmn:incoming>
      <bpmn:outgoing>flow-6</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>nurses</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:task id="minor" name="Minor">
      <bpmn:incoming>flow-4</bpmn:incoming>
      <bpmn:outgoing>flow-7</bpmn:outgoing>
      <bpmn:performer>
        <bpmn:resourceRef>nurses</bpmn:resourceRef>
      </bpmn:performer>
    </bpmn:task>
    <bpmn:endEvent id="seen" name="Seen">
      <bpmn:incoming>flow-5</bpmn:incoming>
      <bpmn:incoming>flow-6</bpmn:incoming>
      <bpmn:incoming>flow-7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow-1" sourceRef="patients" targetRef="triage"/>
    <bpmn:sequenceFlow id="flow-2" sourceRef="triage" targetRef="urgent"/>
    <bpmn:sequenceFlow id="flow-3" sourceRef="triage" targetRef="standard"/>
    <bpmn:sequenceFlow id="flow-4" sourceRef="triage" targetRef="minor"/>
    <bpmn:sequenceFlow id="flow-5" sourceRef="urgent" targetRef="seen"/>
    <bpmn:sequenceFlow id="flow-6" sourceRef="standard" targetRef="seen"/>
    <bpmn:sequenceFlow id="flow-7" sourceRef="minor" targetRef="seen"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="process">
      <bpmndi:BPMNShape id="patients_di" bpmnElement="patients">
        <dc:Bounds x="82" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="triage_di" bpmnElement="triage">
        <dc:Bounds x="255" y="75" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="urgent_di" bpmnElement="urgent">
        <dc:Bounds x="410" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="standard_di" bpmnElement="standard">
        <dc:Bounds x="410" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="minor_di" bpmnElement="minor">
        <dc:Bounds x="410" y="340" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="seen_di" bpmnElement="seen">
        <dc:Bounds x="622" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow-1_di" bpmnElement="flow-1">
        <di:waypoint x="118" y="100"/>
        <di:waypoint x="255" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-2_di" bpmnElement="flow-2">
        <di:waypoint x="305" y="100"/>
        <di:waypoint x="410" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-3_di" bpmnElement="flow-3">
        <di:waypoint x="305" y="100"/>
        <di:waypoint x="410" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-4_di" bpmnElement="flow-4">
        <di:waypoint x="305" y="100"/>
        <di:waypoint x="410" y="380"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-5_di" bpmnElement="flow-5">
        <di:waypoint x="510" y="100"/>
        <di:waypoint x="622" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-6_di" bpmnElement="flow-6">
        <di:waypoint x="510" y="240"/>
        <di:waypoint x="622" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow-7_di" bpmnElement="flow-7">
        <di:waypoint x="510" y="380"/>
        <di:waypoint x="622" y="100"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmn:relationship type="BPSimData">
    <bpmn:extensionElements>
      <bpsim:BPSimData>
        <bpsim:Scenario id="scenario" name="Emergency triage" vendor="StochCraft" version="0.1.0">
          <bpsim:ScenarioParameters replication="10" seed="1" baseTimeUnit="min">
            <bpsim:Duration>
              <bpsim:FloatingParameter value="55000"/>
            </bpsim:Duration>
            <bpsim:Warmup>
              <bpsim:FloatingParameter value="5000"/>
            </bpsim:Warmup>
          </bpsim:ScenarioParameters>
          <bpsim:ElementParameters elementRef="patients">
            <bpsim:ControlParameters>
              <bpsim:InterTriggerTimer>
                <bpsim:NegativeExponentialDistribution mean="5"/>
              </bpsim:InterTriggerTimer>
            </bpsim:ControlParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="urgent">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NegativeExponentialDistribution mean="15"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ExpressionParameter value="getResource('nurses', 1)"/>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
            <bpsim:PriorityParameters>
              <bpsim:Priority>
                <bpsim:FloatingParameter value="3"/>
              </bpsim:Priority>
            </bpsim:PriorityParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="standard">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NegativeExponentialDistribution mean="15"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ExpressionParameter value="getResource('nurses', 1)"/>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
            <bpsim:PriorityParameters>
              <bpsim:Priority>
                <bpsim:FloatingParameter value="2"/>
              </bpsim:Priority>
            </bpsim:PriorityParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="minor">
            <bpsim:TimeParameters>
              <bpsim:ProcessingTime>
                <bpsim:NegativeExponentialDistribution mean="15"/>
              </bpsim:ProcessingTime>
            </bpsim:TimeParameters>
            <bpsim:ResourceParameters>
              <bpsim:Selection>
                <bpsim:ExpressionParameter value="getResource('nurses', 1)"/>
              </bpsim:Selection>
            </bpsim:ResourceParameters>
            <bpsim:PriorityParameters>
              <bpsim:Priority>
                <bpsim:FloatingParameter value="1"/>
              </bpsim:Priority>
            </bpsim:PriorityParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="flow-2">
            <bpsim:ControlParameters>
              <bpsim:Probability>
                <bpsim:FloatingParameter value="0.2"/>
              </bpsim:Probability>
            </bpsim:ControlParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="flow-3">
            <bpsim:ControlParameters>
              <bpsim:Probability>
                <bpsim:FloatingParameter value="0.5"/>
              </bpsim:Probability>
            </bpsim:ControlParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="flow-4">
            <bpsim:ControlParameters>
              <bpsim:Probability>
                <bpsim:FloatingParameter value="0.3"/>
              </bpsim:Probability>
            </bpsim:ControlParameters>
          </bpsim:ElementParameters>
          <bpsim:ElementParameters elementRef="nurses">
            <bpsim:ResourceParameters>
              <bpsim:Quantity>
                <bpsim:NumericParameter value="5"/>
              </bpsim:Quantity>
            </bpsim:ResourceParameters>
            <bpsim:VendorExtension name="stochcraft:pool" xmlns:stochcraft="https://helenkwok.github.io/StochCraft/bpsim/1" stochcraft:value="true"/>
          </bpsim:ElementParameters>
        </bpsim:Scenario>
      </bpsim:BPSimData>
    </bpmn:extensionElements>
    <bpmn:source>definitions</bpmn:source>
    <bpmn:target>definitions</bpmn:target>
  </bpmn:relationship>
</bpmn:definitions>
