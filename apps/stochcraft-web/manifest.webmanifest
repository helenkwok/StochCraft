{
  "name": "StochCraft",
  "short_name": "StochCraft",
  "description": "Discrete-event simulation: open a BPMN or XPDL model with BPSim data, run it and read the results.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1b1b1b",
  "theme_color": "#0b6e86",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
