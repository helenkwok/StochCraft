<?xml version="1.0" encoding="UTF-8"?>
<!--
  StochCraft's extensions to SCXML 1.0 (MIT OR Apache-2.0), for agents' state charts (ROADMAP
  M4.3, decisions D16 and D17).

  SCXML allows attributes and elements of other namespaces on its elements and in its executable
  content, which W3C's schema checks laxly: this schema declares StochCraft's, so that a
  validator checks them too. Validate with it imported next to W3C's SCXML 1.0 schema.

  A chart's expressions are in the `stochcraft` data model (datamodel="stochcraft"): BPSim's
  XPath 1.0 subset with SCXML's In() and StochCraft's functions. Generic SCXML tools read the
  chart's structure but do not run these expressions, nor what follows.

  On <send>:
    stochcraft:rate     an expression: the delay is exponential with this rate, drawn again
                        whenever a variable the rate reads changes. The send also carries
                        delayexpr="exponential(1 div (rate))", the same delay drawn once.
    stochcraft:delay    the delay in the model's time unit, exactly, where the CSS2 time in
                        `delay` (seconds) would not convert back to the same number, or is none.
    stochcraft:to       a message to other agents: agent (stochcraft:serial gives its serial
                        number), random (one other agent), all (every other agent), linked and
                        linkedRandom (along the network), neighbours and neighbourRandom (on the
                        grid), of stochcraft:population. Such a send has
                        type="https://helenkwok.github.io/StochCraft/scxml/1#agents", StochCraft's
                        own event I/O processor, and its data in <content expr>.

  Executable content:
    <stochcraft:create population="p"/>                   a new agent of p
    <stochcraft:remove population="p" serial="expr"/>      removes that agent
    <stochcraft:connect population="p" serial="expr"/>     links the agent to that one
    <stochcraft:disconnect population="p" serial="expr"/>  removes that link
    <stochcraft:moveTo population="p" row="expr" column="expr"/>  moves on p's grid
    <stochcraft:moveRandom population="p"/>                to a free neighbouring cell
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:stochcraft="https://helenkwok.github.io/StochCraft/scxml/1"
    targetNamespace="https://helenkwok.github.io/StochCraft/scxml/1"
    elementFormDefault="qualified">
  <xs:attribute name="rate" type="xs:string"/>
  <xs:attribute name="delay" type="xs:double"/>
  <xs:attribute name="to">
    <xs:simpleType>
      <xs:restriction base="xs:string">
        <xs:enumeration value="agent"/>
        <xs:enumeration value="random"/>
        <xs:enumeration value="all"/>
        <xs:enumeration value="linked"/>
        <xs:enumeration value="linkedRandom"/>
        <xs:enumeration value="neighbours"/>
        <xs:enumeration value="neighbourRandom"/>
      </xs:restriction>
    </xs:simpleType>
  </xs:attribute>
  <xs:attribute name="population" type="xs:string"/>
  <xs:attribute name="serial" type="xs:string"/>
  <xs:complexType name="Population">
    <xs:attribute name="population" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="Agent">
    <xs:attribute name="population" type="xs:string" use="required"/>
    <xs:attribute name="serial" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:element name="create" type="stochcraft:Population"/>
  <xs:element name="moveRandom" type="stochcraft:Population"/>
  <xs:element name="remove" type="stochcraft:Agent"/>
  <xs:element name="connect" type="stochcraft:Agent"/>
  <xs:element name="disconnect" type="stochcraft:Agent"/>
  <xs:element name="moveTo">
    <xs:complexType>
      <xs:attribute name="population" type="xs:string" use="required"/>
      <xs:attribute name="row" type="xs:string" use="required"/>
      <xs:attribute name="column" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
