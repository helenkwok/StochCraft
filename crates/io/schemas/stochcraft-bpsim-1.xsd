  <!--
    The physical layout (ROADMAP.md, M5.5). Distances are in the scenario's length unit, headings
    and angles in degrees (0 along +x, positive turning left), z up from the floor.

    stochcraft:path, on a conveyor's ElementParameters: its track, a start frame (x, y, z,
    heading), the belt's width (drawn only; when left out, 0.6 m in the scenario's unit) and line,
    arc and helix segments, each going on from the end of the one before. The conveyor's length
    is the path's, to 0.1 mm; a conveyor length that differs from it by more is an override,
    which StochCraft flags.

    stochcraft:place, on a block's ElementParameters: where it stands, a frame (x, y, z, heading)
    or a distance s along a conveyor's track (path names the conveyor). A divert gateway placed
    along the conveyor that sends into it is a point of that conveyor: items meet it as their
    front reaches s.

    stochcraft:junction, on the ElementParameters of a sequence flow from one conveyor to
    another: how their sections join (kind: inline, side or turntable) and the time across the
    junction (transfer, in the scenario's base time unit, 0 or more).

    stochcraft:decision, on a task's or an exclusive gateway's ElementParameters: the decision
    table it uses (DMN 1.6). file is the .dmn file, relative to the model's file; decision is the
    decision's id in it; route, on a gateway whose table has several outputs, names the output
    to route by. As an entity enters, the table is evaluated on its properties and the outputs
    are written back as properties. A gateway none of whose ways out has a condition takes the
    way whose flow id, target id or target name is the output's value.

    <bpsim:VendorExtension name="stochcraft:decision" xmlns:stochcraft="…">
      <stochcraft:decision file="sorting.dmn" decision="chute"/>
    </bpsim:VendorExtension>

    stochcraft:scene, a child of the scenario: look-only scenery, one object per element with an
    id, a kind (floor, wall, pallet, column, marking...), its centre frame and its size. The run
    never reads it. version says which vocabulary of kinds the scene uses.
  -->
  <xs:attributeGroup name="Frame">
    <xs:attribute name="x" type="xs:double" use="required"/>
    <xs:attribute name="y" type="xs:double" use="required"/>
    <xs:attribute name="z" type="xs:double" default="0"/>
    <xs:attribute name="heading" type="xs:double" default="0"/>
  </xs:attributeGroup>
  <xs:element name="path">
    <xs:complexType>
      <xs:choice maxOccurs="unbounded">
        <xs:element name="line">
          <xs:complexType>
            <xs:attribute name="length" type="xs:double" use="required"/>
            <xs:attribute name="rise" type="xs:double" default="0"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="arc">
          <xs:complexType>
            <xs:attribute name="radius" type="xs:double" use="required"/>
            <xs:attribute name="angle" type="xs:double" use="required"/>
            <xs:attribute name="rise" type="xs:double" default="0"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="helix">
          <xs:complexType>
            <xs:attribute name="radius" type="xs:double" use="required"/>
            <xs:attribute name="rise" type="xs:double" use="required"/>
            <xs:attribute name="turns" type="xs:double" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:choice>
      <xs:attributeGroup ref="stochcraft:Frame"/>
      <xs:attribute name="width" type="xs:double"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="place">
    <xs:complexType>
      <xs:attribute name="x" type="xs:double"/>
      <xs:attribute name="y" type="xs:double"/>
      <xs:attribute name="z" type="xs:double" default="0"/>
      <xs:attribute name="heading" type="xs:double" default="0"/>
      <xs:attribute name="path" type="xs:string"/>
      <xs:attribute name="s" type="xs:double"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="decision">
    <xs:complexType>
      <xs:attribute name="file" type="xs:string" use="required"/>
      <xs:attribute name="decision" type="xs:string" use="required"/>
      <xs:attribute name="route" type="xs:string"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="junction">
    <xs:complexType>
      <xs:attribute name="kind" default="inline">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="inline"/>
            <xs:enumeration value="side"/>
            <xs:enumeration value="turntable"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="transfer" type="xs:double" default="0"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="scene">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="object" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="id" type="xs:string" use="required"/>
            <xs:attribute name="kind" type="xs:string" use="required"/>
            <xs:attributeGroup ref="stochcraft:Frame"/>
            <xs:attribute name="width" type="xs:double" default="0"/>
            <xs:attribute name="depth" type="xs:double" default="0"/>
            <xs:attribute name="height" type="xs:double" default="0"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="agents">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="agentType" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="name" type="xs:string" use="required"/>
            <xs:attribute name="chart" type="xs:anyURI" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="population" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="network" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="link" minOccurs="0" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:attribute name="a" type="xs:nonNegativeInteger" use="required"/>
                        <xs:attribute name="b" type="xs:nonNegativeInteger" use="required"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                  <xs:attribute name="kind" use="required">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:enumeration value="empty"/>
                        <xs:enumeration value="random"/>
                        <xs:enumeration value="ring"/>
                        <xs:enumeration value="smallWorld"/>
                        <xs:enumeration value="scaleFree"/>
                        <xs:enumeration value="distance"/>
                        <xs:enumeration value="links"/>
                        <xs:enumeration value="file"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:attribute>
                  <xs:attribute name="meanDegree" type="xs:double"/>
                  <xs:attribute name="eachSide" type="xs:nonNegativeInteger"/>
                  <xs:attribute name="rewire" type="xs:double"/>
                  <xs:attribute name="initial" type="xs:nonNegativeInteger"/>
                  <xs:attribute name="links" type="xs:nonNegativeInteger"/>
                  <xs:attribute name="width" type="xs:double"/>
                  <xs:attribute name="height" type="xs:double"/>
                  <xs:attribute name="range" type="xs:double"/>
                  <xs:attribute name="href" type="xs:anyURI"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="grid" minOccurs="0">
                <xs:complexType>
                  <xs:attribute name="rows" type="xs:nonNegativeInteger" use="required"/>
                  <xs:attribute name="columns" type="xs:nonNegativeInteger" use="required"/>
                  <xs:attribute name="neighbourhood" default="moore">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:enumeration value="moore"/>
                        <xs:enumeration value="vonNeumann"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:attribute>
                  <xs:attribute name="wrap" type="xs:boolean" default="false"/>
                  <xs:attribute name="perCell" default="one">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:enumeration value="one"/>
                        <xs:enumeration value="many"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:attribute>
                  <xs:attribute name="placement" default="inOrder">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:enumeration value="inOrder"/>
                        <xs:enumeration value="random"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:attribute>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="name" type="xs:string" use="required"/>
            <xs:attribute name="type" type="xs:string" use="required"/>
            <xs:attribute name="count" type="xs:nonNegativeInteger" default="0"/>
            <xs:attribute name="arrivalRate" type="xs:double"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="environment" minOccurs="0">
          <xs:complexType>
            <xs:attribute name="type" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="statistic" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="name" type="xs:string" use="required"/>
            <xs:attribute name="population" type="xs:string" use="required"/>
            <xs:attribute name="measure" default="count">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:enumeration value="count"/>
                  <xs:enumeration value="sum"/>
                  <xs:enumeration value="mean"/>
                  <xs:enumeration value="min"/>
                  <xs:enumeration value="max"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="expression" type="xs:string"/>
            <xs:attribute name="condition" type="xs:string"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="stepping" minOccurs="0">
          <xs:complexType>
            <xs:attribute name="every" type="xs:double" use="required"/>
            <xs:attribute name="order" default="fixed">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:enumeration value="fixed"/>
                  <xs:enumeration value="random"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="saveEvery" type="xs:double"/>
      <xs:attribute name="microstepLimit" type="xs:nonNegativeInteger"/>
      <xs:attribute name="retestLimit" type="xs:nonNegativeInteger"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
